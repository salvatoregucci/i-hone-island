<Window x:Class="iLand.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="iLand"
        Width="190" Height="44"
        MinWidth="190" MinHeight="44"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <SolidColorBrush x:Key="GlassStroke" Color="#5A5A5A"/>
        <LinearGradientBrush x:Key="IslandFill" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#101214" Offset="0"/>
            <GradientStop Color="#090A0D" Offset="0.35"/>
            <GradientStop Color="#050607" Offset="1"/>
        </LinearGradientBrush>
    </Window.Resources>

    <Border x:Name="Island"
            Background="{StaticResource IslandFill}"
            BorderBrush="{StaticResource GlassStroke}"
            BorderThickness="1"
            CornerRadius="24"
            Padding="15"
            MouseEnter="Island_MouseEnter"
            MouseLeave="Island_MouseLeave"
            MouseWheel="Island_MouseWheel"
            MouseLeftButtonDown="Island_MouseLeftButtonDown"
            MouseLeftButtonUp="Island_MouseLeftButtonUp"
            ClipToBounds="True">

        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="8" Direction="270" Opacity="0.45" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="26"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Ellipse Width="9" Height="9" Fill="#30D158"
                         VerticalAlignment="Center" Margin="0,0,9,0"/>

                <TextBlock x:Name="IslandTitle" Grid.Column="1"
                           Text="iLand" Foreground="#F5F5F7" FontSize="12"
                           FontWeight="SemiBold" VerticalAlignment="Center"/>

                <TextBlock x:Name="PageIndicator" Grid.Column="2" Text="1 / 3"
                           Foreground="#8A8A8E" FontSize="10" VerticalAlignment="Center"/>
            </Grid>

            <Grid Grid.Row="1" x:Name="ExpandedContent" Visibility="Collapsed" Margin="0,12,0,0">
                <Grid x:Name="HomePage" Visibility="Visible">
                    <StackPanel>
                        <TextBlock x:Name="ClockText" Text="12:00"
                                   FontSize="34" FontWeight="SemiBold"
                                   Foreground="#FFFFFF"/>

                        <TextBlock x:Name="DateText" Text="Saturday"
                                   Foreground="#A1A1A6" FontSize="12"
                                   Margin="0,2,0,14"/>

                        <Border Background="#181A1D" BorderBrush="#2A2C2F" BorderThickness="1"
                                CornerRadius="14" Padding="12">
                            <StackPanel>
                                <TextBlock Text="Now Playing" Foreground="#8D8D92" FontSize="10"/>
                                <TextBlock x:Name="MusicText" Text="Waiting for music..."
                                           Foreground="#FFFFFF" FontSize="13" Margin="0,7,0,0"/>
                                <TextBlock Text="Windows Media Player" Foreground="#6F6F73" FontSize="10"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <StackPanel x:Name="MonitorPage" Visibility="Collapsed">
                    <TextBlock Text="SYSTEM" Foreground="#8C8C90" FontSize="10" Margin="0,0,0,12"/>

                    <TextBlock x:Name="CpuText" Text="CPU  0%" Foreground="#F5F5F7" FontSize="12"/>
                    <ProgressBar x:Name="CpuBar" Maximum="100" Height="5" Margin="0,5,0,12" Foreground="#7ED957" Background="#1F2023"/>

                    <TextBlock x:Name="GpuText" Text="GPU  --" Foreground="#F5F5F7" FontSize="12"/>
                    <ProgressBar x:Name="GpuBar" Maximum="100" Height="5" Margin="0,5,0,12" Foreground="#60A5FA" Background="#1F2023"/>

                    <TextBlock x:Name="RamText" Text="RAM  0%" Foreground="#F5F5F7" FontSize="12"/>
                    <ProgressBar x:Name="RamBar" Maximum="100" Height="5" Margin="0,5,0,12" Foreground="#F7B955" Background="#1F2023"/>

                    <TextBlock x:Name="VramText" Text="VRAM  --" Foreground="#919196" FontSize="11"/>
                </StackPanel>

                <StackPanel x:Name="TemperaturePage" Visibility="Collapsed">
                    <TextBlock Text="TEMPERATURES" Foreground="#8C8C90" FontSize="10" Margin="0,0,0,15"/>

                    <TextBlock x:Name="CpuTempText" Text="CPU  -- °C" Foreground="#F5F5F7" FontSize="17" Margin="0,0,0,12"/>
                    <TextBlock x:Name="GpuTempText" Text="GPU  -- °C" Foreground="#F5F5F7" FontSize="17" Margin="0,0,0,12"/>
                    <TextBlock x:Name="FanText" Text="Fans  -- RPM" Foreground="#A7A7AC" FontSize="12"/>
                    <TextBlock Text="Hardware sensor data" Foreground="#67676B" FontSize="10" Margin="0,20,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                    <Button Content="●" Click="PreviousPage" Background="Transparent" Foreground="#58585B" BorderThickness="0" Padding="6,0"/>
                    <Button Content="●" Click="NextPage" Background="Transparent" Foreground="#58585B" BorderThickness="0" Padding="6,0"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
