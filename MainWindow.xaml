<Window x:Class="iLand.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="iLand"
        Width="190" Height="44"
        MinWidth="190" MinHeight="44"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">

    <Border x:Name="Island"
            Background="#050505"
            BorderBrush="#202020"
            BorderThickness="1"
            CornerRadius="24"
            Padding="15"
            MouseEnter="Island_MouseEnter"
            MouseLeave="Island_MouseLeave"
            MouseWheel="Island_MouseWheel"
            MouseLeftButtonDown="Island_MouseLeftButtonDown"
            MouseLeftButtonUp="Island_MouseLeftButtonUp"
            ClipToBounds="True">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="26"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Ellipse Width="9" Height="9" Fill="#30D158"
                         VerticalAlignment="Center" Margin="0,0,9,0"/>
                <TextBlock x:Name="IslandTitle" Grid.Column="1" Text="iLand"
                           Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                <TextBlock x:Name="PageIndicator" Grid.Column="2" Text="1 / 3"
                           Foreground="#777777" FontSize="10" VerticalAlignment="Center"/>
            </Grid>

            <Grid Grid.Row="1" x:Name="ExpandedContent"
                  Visibility="Collapsed" Margin="0,12,0,0">
                <Grid x:Name="HomePage" Visibility="Visible">
                    <StackPanel>
                        <TextBlock x:Name="ClockText" Text="12:00" FontSize="34"
                                   FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock x:Name="DateText" Text="Saturday" Foreground="#999999"
                                   FontSize="12" Margin="0,2,0,14"/>
                        <Border Background="#191919" CornerRadius="14" Padding="12">
                            <StackPanel>
                                <TextBlock Text="♫  Сейчас играет" Foreground="#AAAAAA" FontSize="11"/>
                                <TextBlock x:Name="MusicText" Text="Ожидание музыки..."
                                           Foreground="White" FontSize="13" Margin="0,7,0,0"/>
                                <TextBlock Text="Медиаплеер Windows" Foreground="#777777" FontSize="10"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <StackPanel x:Name="MonitorPage" Visibility="Collapsed">
                    <TextBlock Text="СИСТЕМА" Foreground="#999999" FontSize="10" Margin="0,0,0,12"/>
                    <TextBlock x:Name="CpuText" Text="CPU  0%" Foreground="White"/>
                    <ProgressBar x:Name="CpuBar" Maximum="100" Height="5" Margin="0,5,0,12"/>
                    <TextBlock x:Name="GpuText" Text="GPU  --" Foreground="White"/>
                    <ProgressBar x:Name="GpuBar" Maximum="100" Height="5" Margin="0,5,0,12"/>
                    <TextBlock x:Name="RamText" Text="RAM  0%" Foreground="White"/>
                    <ProgressBar x:Name="RamBar" Maximum="100" Height="5" Margin="0,5,0,12"/>
                    <TextBlock x:Name="VramText" Text="VRAM  --" Foreground="#AAAAAA" FontSize="11"/>
                </StackPanel>

                <StackPanel x:Name="TemperaturePage" Visibility="Collapsed">
                    <TextBlock Text="ТЕМПЕРАТУРЫ" Foreground="#999999" FontSize="10" Margin="0,0,0,15"/>
                    <TextBlock x:Name="CpuTempText" Text="CPU  -- °C" Foreground="White" FontSize="17" Margin="0,0,0,12"/>
                    <TextBlock x:Name="GpuTempText" Text="GPU  -- °C" Foreground="White" FontSize="17" Margin="0,0,0,12"/>
                    <TextBlock x:Name="FanText" Text="Вентиляторы  -- RPM" Foreground="#AAAAAA" FontSize="12"/>
                    <TextBlock Text="Данные аппаратных датчиков" Foreground="#666666" FontSize="10" Margin="0,20,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                            VerticalAlignment="Bottom">
                    <Button Content="●" Click="PreviousPage" Background="Transparent"
                            Foreground="#777777" BorderThickness="0"/>
                    <Button Content="●" Click="NextPage" Background="Transparent"
                            Foreground="#777777" BorderThickness="0"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
