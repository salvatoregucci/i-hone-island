<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>iLand</AssemblyName>
    <RootNamespace>iLand</RootNamespace>
    <Platforms>x86;x64</Platforms>
    <PlatformTarget Condition="'$(RuntimeIdentifier)' == 'win-x86' or '$(Platform)' == 'x86'">x86</PlatformTarget>
    <PlatformTarget Condition="'$(RuntimeIdentifier)' == 'win-x64' or '$(Platform)' == 'x64' or '$(Platform)' == ''">x64</PlatformTarget>
    <Prefer32Bit Condition="'$(PlatformTarget)' == 'x86'">true</Prefer32Bit>
    <Prefer32Bit Condition="'$(PlatformTarget)' == 'x64'">false</Prefer32Bit>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="8.0.1" />
  </ItemGroup>
</Project>
